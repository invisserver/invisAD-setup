# Dieses Script führt alle zur Installation eines invis Servers AD notwendigen 
# Konfigurationsschritte aus.
# Das Script sine nutzt /var/lib/sine als Arbeitsverzeichnis, hier sind von sine
# verwendete Kontroll-, Variablen- und Protokolldateien zu finden.

# Dieses Programm ist freie Software. Sie können es unter den Bedingungen der 
# GNU General Public License, wie von der Free Software Foundation veröffentlicht,
# weitergeben und/oder modifizieren, entweder gemäß Version 3 der Lizenz oder
# (nach Ihrer Option) jeder späteren Version.

# Die Veröffentlichung dieses Programms erfolgt in der Hoffnung, daß es Ihnen
# von Nutzen sein wird, aber OHNE IRGENDEINE GARANTIE, sogar ohne die implizite 
# Garantie der MARKTREIFE oder der VERWENDBARKEIT FÜR EINEN BESTIMMTEN ZWECK. 
# Details finden Sie in der GNU General Public License.

# Sie sollten ein Exemplar der GNU General Public License zusammen mit diesem 
# Programm erhalten haben. Falls nicht, siehe <http://www.gnu.org/licenses/>.

# Konfigurationsdaten
conffile="/etc/invis/invis.conf"
passfile="/etc/invis/invis-pws.conf"
logfile="/var/log/gw-failover.log"

# Funktionen
# Werte aus Konfigurationsdatendatei extrahieren
# $1 = Konfigurationsdatei, $2 = Parameter, $3 Wert (Feld)
getconfdata() {
    cat $1 |grep "$2" | cut -d ":" -f $3
}

contains() {
    printf '%s\n' "${@:2}" | grep -qxF -- "$1"
}

# LDAP Basisknoten fuer invis-Server auslesen
failover=`getconfdata $conffile failoverGateway 2`
if [[ $failover == j ]]; then

    # --- Konfiguration ---
    primary_gw=`getconfdata $conffile primaryGW 3`	# Glasfaser
    primary_dev=`getconfdata $conffile primaryGW 2`
    backup_gw=`getconfdata $conffile primaryGW 3`	# Telekom (für Portweiterleitungen)
    backup_dev=`getconfdata $conffile primaryGW 2`
    test_host="9.9.9.9"         			# Testziel
    check_interval=30           			# Sekunden
    asymetric=`getconfdata $conffile asymetricRouting 2`

    if [[ $asymetric == j ]] ; then
	if [[ ! -f /etc/firewalld/direct.xml ]]; then
	    cp /usr/share/sine/templates/firewall/direct.xml /etc/firewalld/
	    systemctl restart firewalld.service
	elif [[ -f /etc/firewalld/direct.xml ]] && [[ ! `grep "Asymetrisches Routing" /etc/firewalld/direct.xml 2>/dev/null` ]]
	    echo -e "Es existiert bereits eine Datei direct.xml in /etc/firewalld die die erforderlichen Anweisungen für asymetrisches Routing nicht enthält.\nSie müssen die Datei händisch anpassen." | tee $logfile
	    exit 1
	fi
	
    # --- Funktion zum Wechseln des Gateways ---
    set_gateway() {
	local gw=$1
	local dev=$2
	ip route del default 2>/dev/null
	ip route add default via $gw dev $dev
	echo "$(date) - Gateway gewechselt zu $gw ($dev)" >> $logfile
	
	if [[ $asymetric == j ]]; then
	    # Routing-Regel für asymmetrisches Routing aktualisieren
	    ip route flush table 100 2>/dev/null
	    ip route add default via $backup_gw dev $backup_dev table 100
	fi
    }

    # --- Initialisierung ---
    # 1. Standardroute auf Glasfaser setzen
    set_gateway $primary_gw $brimary_dev

    if [[ $asymetric == j ]]; then
	# 2. Routing-Regel für Antworten (asymmetrisches Routing)
	ip rule del fwmark 1 2>/dev/null
	ip rule add fwmark 1 lookup 100
    fi

    # --- Hauptschleife ---
    while true; do
	# Prüfe, ob primäres Gateway erreichbar ist
	if ping -c 1 -W 1 $test_host >/dev/null 2>&1; then
	    # Primär funktioniert: Stelle sicher, dass es aktiv ist
	    current_gw=$(ip route show default | grep -oP 'via \K[^\s]+')
	    if [ "$current_gw" != "$primary_gw" ]; then
        	set_gateway $primary_gw $primary_dev
	    fi
	else
	    # Primär nicht erreichbar: Wechsle zu Backup
	    set_gateway $backup_gw $backup_dev
	fi
	sleep $check_interval
    done
fi